// Part C source: sequential Vector Dot-Product Accelerator in Anvil.
// The compiler emits generated/dot_product_anvil.sv; that file is an artifact
// for simulation rather than a second hand-maintained implementation.
//
// Each channel uses Anvil's normal dynamic two-way handshake.  A sender must
// keep its payload and valid asserted until the rising edge at which ack is
// observed.  The response messages use the same convention.

struct element_pair {
    a : logic[8],
    b : logic[8]
}

struct command {
    length : logic[8],
    tag    : logic[4]
}

struct tagged_result {
    // Keep the representation in 4-bit chunks.  This matches the result of
    // the equal-width concatenations used to widen multiplication operands.
    value : logic[5][4],
    tag   : logic[4]
}

chan cmd_ch {
    left  cmd_req : (command @ cmd_req),
    right cmd_res : (logic @ cmd_req)
}

chan elem_ch {
    left  in_req : (element_pair @ in_req),
    right in_res : (logic @ in_req)
}

chan result_ch {
    right out_req : (tagged_result @ out_req),
    left  out_res : (logic @ out_req)
}

proc DotProduct(
    cmd  : left cmd_ch,
    elem : left elem_ch,
    res  : left result_ch
) {
    reg accum     : logic[5][4];
    reg remaining : logic[8];
    reg saved_tag : logic[4];
    reg state     : logic[2]; // 0 = idle, 1 = calculate, 2 = output

    loop {
        if (*state == 2'd0) {
            let cmd_data = recv cmd.cmd_req >>
            set saved_tag := cmd_data.tag >>
            set accum     := #{4'd0, 4'd0, 4'd0, 4'd0, 4'd0} >>
            set remaining := cmd_data.length >>
            send cmd.cmd_res(1'b1) >>
            set state := 2'd1
        } else {
            if (*state == 2'd1) {
                if (*remaining == 8'd0) {
                    set state := 2'd2
                } else {
                    let pair = recv elem.in_req >>
                    // Anvil multiplication has the width of its operands.
                    // Extend each 8-bit input to the accumulator width before
                    // multiplying; #{...} is Anvil's concatenation syntax.
                    // Concatenation operands must have equal widths in the
                    // current compiler, so build the 20-bit values from
                    // 4-bit chunks.
                    let p_a = #{4'd0, 4'd0, 4'd0, pair.a[4+:4], pair.a[0+:4]} >>
                    let p_b = #{4'd0, 4'd0, 4'd0, pair.b[4+:4], pair.b[0+:4]} >>
                    let prod = p_a * p_b >>
                    set accum := *accum + prod >>
                    set remaining := *remaining - 8'd1 >>
                    send elem.in_res(1'b1)
                }
            } else {
                send res.out_req(tagged_result::{ value = *accum; tag = *saved_tag }) >>
                let _ = recv res.out_res >>
                set state := 2'd0
            }
        }
    }
}
