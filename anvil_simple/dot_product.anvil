// ================================================================
// Vector Dot-Product Accelerator — Simple Anvil Implementation
// This version compiles successfully but is sequential (not 4-lane).
// ================================================================

struct element_pair {
    a : logic[16],
    b : logic[16]
}

struct command {
    length : logic[8],
    tag    : logic[4]
}

chan cmd_ch {
    left  cmd_req : (command @ cmd_res),
    right cmd_res : (logic   @ #1)
}

chan elem_ch {
    left  in_req : (element_pair @ in_res),
    right in_res : (logic        @ #1)
}

chan result_ch {
    right out_req : (logic[16] @ out_res),
    left  out_res : (logic     @ #1)
}

proc DotProduct(cmd  : left cmd_ch,
                elem : left elem_ch,
                res  : left result_ch) {

    reg accum     : logic[16];
    reg remaining : logic[8];
    reg saved_tag : logic[4];

    loop {
        let cmd_data = recv cmd.cmd_req >>
        set saved_tag := cmd_data.tag;
        set accum     := 16'd0;
        set remaining := cmd_data.length >>
        send cmd.cmd_res(1'b1)
    }

    loop {
        if *remaining == 8'd0 {
            cycle 1
        } else {
            let pair = recv elem.in_req >>
            set accum     := *accum + (pair.a * pair.b);
            set remaining := *remaining - 8'd1 >>
            send elem.in_res(1'b1)
        }
    }

    loop {
        send res.out_req(*accum) >>
        let _ = recv res.out_res >>
        cycle 1
    }
}

proc DotProductTop() {
    chan cmd_le  -- cmd_ri  : cmd_ch;
    chan elem_le -- elem_ri : elem_ch;
    chan res_le  -- res_ri  : result_ch;

    spawn DotProduct(cmd_le, elem_le, res_le);

    reg cycle_ctr : logic[16];
    loop {
        set cycle_ctr := *cycle_ctr + 16'd1
    }

    loop {
        send cmd_ri.cmd_req(command::{length=8'd4; tag=4'd1}) >>
        let ack = recv cmd_ri.cmd_res >>

        send elem_ri.in_req(element_pair::{a=16'd1; b=16'd5}) >>
        let ack1 = recv elem_ri.in_res >>

        send elem_ri.in_req(element_pair::{a=16'd2; b=16'd6}) >>
        let ack2 = recv elem_ri.in_res >>

        send elem_ri.in_req(element_pair::{a=16'd3; b=16'd7}) >>
        let ack3 = recv elem_ri.in_res >>

        send elem_ri.in_req(element_pair::{a=16'd4; b=16'd8}) >>
        let ack4 = recv elem_ri.in_res >>

        let result = recv res_ri.out_req >>
        send res_ri.out_res(1'b1) >>
        cycle 1 >>
        dfinish
    }
}